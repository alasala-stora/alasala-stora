rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // المنتجات: يشوفها الجميع، والتعديل فقط لصاحبة المتجر (بعد تسجيل الدخول)
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // إعدادات المتجر: قراءة عامة، وتعديل فقط لصاحبة المتجر
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // المندوبات: قراءة عامة (تحتاجها صفحة إحصائيات المندوبة)، وتعديل فقط لصاحبة المتجر
    match /dealers/{dealerId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // الطلبات: أي زبونة تقدر تنشئ طلب جديد فقط (ما تقدر تشوف طلبات الغير ولا تعدّلها)
    // التأكيد/الإلغاء/الحذف فقط لصاحبة المتجر
    match /orders/{orderId} {
      allow create: if request.resource.data.status == 'pending';
      allow read, update, delete: if request.auth != null;
    }

    // توكنات الإشعارات: أي زائرة تقدر تسجل توكنها فقط، ما تقدر تشوف توكنات الغير
    match /fcmTokens/{tokenId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
